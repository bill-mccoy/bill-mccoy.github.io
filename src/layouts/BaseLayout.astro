---
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { ClientRouter } from "astro:transitions";
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  SITE_URL,
  AUTHOR,
} from "../data/site";
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION, image } =
  Astro.props;
const pageTitle = title === SITE_TITLE ? SITE_TITLE : `${title} — Juan Cortes`;
const ogImage = image
  ? image.startsWith("http")
    ? image
    : `${SITE_URL}${image}`
  : `${SITE_URL}/og/default.jpg`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0f1a" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, SITE_URL).href} />

    <ClientRouter />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Juan Cortes" />
    <meta property="og:url" content={new URL(Astro.url.pathname, SITE_URL)} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="flex min-h-screen flex-col">
    <div
      id="scroll-progress"
      class="scroll-progress fixed inset-x-0 top-0 z-[70] h-0.5 origin-left scale-x-0"
      aria-hidden="true"
    ></div>
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)")
    .matches;

  const revealEls = () => document.querySelectorAll<HTMLElement>(".reveal");
  const revealFully = () =>
    revealEls().forEach((el) => el.classList.add("is-visible"));

  const enableReveal = () => {
    const els = Array.from(revealEls());
    if (reduced || !("IntersectionObserver" in window)) {
      revealFully();
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: "0px 0px -40px" },
    );
    els.forEach((el) => {
      const rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        el.classList.add("is-visible");
      } else {
        io.observe(el);
      }
    });
  };

  const bar = document.getElementById("scroll-progress");
  const updateProgress = () => {
    if (!bar) return;
    const doc = document.documentElement;
    const max = doc.scrollHeight - doc.clientHeight;
    const ratio = max > 0 ? doc.scrollTop / max : 0;
    bar.style.transform = `scaleX(${ratio})`;
  };

  const header = document.getElementById("site-header");
  const updateHeader = () =>
    header?.classList.toggle("is-scrolled", window.scrollY > 8);

  let ioSpy: IntersectionObserver | null = null;
  const enableScrollspy = () => {
    ioSpy?.disconnect();
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(
        "#site-header a[data-nav]",
      ),
    );
    if (links.length === 0 || !("IntersectionObserver" in window)) return;
    const activeLink = (id: string) =>
      links.find((l) => l.dataset.nav === id);
    ioSpy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((l) => l.classList.remove("nav-active"));
          activeLink(entry.target.id)?.classList.add("nav-active");
        }
      },
      { rootMargin: "-45% 0px -50% 0px", threshold: 0 },
    );
    document
      .querySelectorAll<HTMLElement>("main section[id]")
      .forEach((s) => ioSpy!.observe(s));
  };

  const attach = () => {
    enableReveal();
    window.addEventListener("scroll", updateProgress, { passive: true });
    window.addEventListener("scroll", updateHeader, { passive: true });
    updateProgress();
    updateHeader();
    enableScrollspy();
  };

  document.addEventListener("astro:page-load", attach);
</script>