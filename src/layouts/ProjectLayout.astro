---
import BaseLayout from "./BaseLayout.astro";
import { DISCIPLINES, sortDisciplines } from "../data/disciplines";
import type { CollectionEntry } from "astro:content";

type ProjectData = CollectionEntry<"projects">["data"];

interface PrevNext {
  title: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  image?: string;
  slug: string;
  project: ProjectData;
  prev?: PrevNext | null;
  next?: PrevNext | null;
}

const { title, description, image, slug, project, prev, next } = Astro.props;
const disciplines = sortDisciplines(project.disciplines);
---

<BaseLayout title={title} description={description} image={image}>
  <article class="mx-auto w-full max-w-4xl px-5 pb-20 pt-12 sm:px-8 sm:pt-16">
    <nav class="reveal" aria-label="Ruta de navegación">
      <ol class="flex flex-wrap items-center gap-2 font-mono text-xs text-faint">
        <li>
          <a href="/" class="transition-colors hover:text-glow">~/</a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/#proyectos" class="transition-colors hover:text-glow">
            proyectos
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="text-mute">{slug}</li>
      </ol>
    </nav>

    <header class="reveal mt-10">
      <div class="flex flex-wrap gap-1.5">
        {
          disciplines.map((d) => (
            <span
              class:list={[
                "rounded-full border px-3 py-1 font-mono text-[11px]",
                DISCIPLINES[d].chip,
              ]}
            >
              {DISCIPLINES[d].label}
            </span>
          ))
        }
      </div>

      <h1 class="mt-6 font-display text-4xl font-bold tracking-tight sm:text-5xl">
        {project.title}
      </h1>

      <div class="mt-6 flex flex-wrap items-center gap-x-8 gap-y-3 font-mono text-xs text-faint">
        {project.org && (
          <span>
            <span class="text-mute">org</span> / {project.org}
          </span>
        )}
        <span>
          <span class="text-mute">rol</span> / {project.role}
        </span>
        <span>
          <span class="text-mute">año</span> / {project.year}
        </span>
      </div>

      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-mute">
        {project.summary}
      </p>
    </header>

    <div class="prose-content reveal mt-10">
      <slot />
    </div>

    <div class="reveal mt-10 flex flex-wrap gap-1.5">
      {
        project.tags.map((tag) => (
          <span class="rounded-md border border-line-soft bg-surface/50 px-2.5 py-1 font-mono text-xs text-mute">
            {tag}
          </span>
        ))
      }
    </div>

    {project.links && project.links.length > 0 && (
      <div class="reveal mt-8 flex flex-wrap gap-3">
        {
          project.links.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noreferrer noopener"
              class="inline-flex items-center gap-2 rounded-lg border border-line bg-surface/60 px-5 py-2.5 text-sm font-semibold text-soft transition-colors hover:border-glow/50 hover:text-glow"
            >
              {link.label}
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 17 17 7" />
                <path d="M7 7h10v10" />
              </svg>
            </a>
          ))
        }
      </div>
    )}

    {(prev || next) && (
      <nav
        class="reveal mt-16 grid gap-4 border-t border-line pt-8 sm:grid-cols-2"
        aria-label="Navegación entre proyectos"
      >
        {prev ? (
          <a
            href={prev.href}
            class="group hover-lift rounded-xl border border-line bg-surface/50 p-5 hover:border-glow/30"
          >
            <span class="font-mono text-[11px] text-faint">
              &larr; ANTERIOR
            </span>
            <span class="mt-2 block font-display text-base font-semibold tracking-tight transition-colors group-hover:text-glow">
              {prev.title}
            </span>
          </a>
        ) : (
          <span aria-hidden="true"></span>
        )}
        {next ? (
          <a
            href={next.href}
            class="group hover-lift rounded-xl border border-line bg-surface/50 p-5 text-right hover:border-glow/30"
          >
            <span class="font-mono text-[11px] text-faint">
              SIGUIENTE &rarr;
            </span>
            <span class="mt-2 block font-display text-base font-semibold tracking-tight transition-colors group-hover:text-glow">
              {next.title}
            </span>
          </a>
        ) : (
          <span aria-hidden="true"></span>
        )}
      </nav>
    )}
  </article>
</BaseLayout>