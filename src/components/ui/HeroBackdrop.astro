<div class="hero-backdrop pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
  <canvas id="hero-backdrop" class="block h-full w-full"></canvas>
</div>

<style>
  .hero-backdrop {
    animation: hero-backdrop-fade-in 1s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes hero-backdrop-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-backdrop {
      animation: none;
    }
  }
</style>

<script>
  import { startHeroBackdrop } from "../../scripts/hero-shader";

  const boot = () => {
    const canvas = document.getElementById("hero-backdrop");
    if (!(canvas instanceof HTMLCanvasElement)) return;
    if (canvas.dataset.backdropActive) return;
    canvas.dataset.backdropActive = "1";
    startHeroBackdrop(canvas);
  };

  boot();
  document.addEventListener("astro:page-load", boot);
</script>