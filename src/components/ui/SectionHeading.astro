---
interface Props {
  kicker: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}

const { kicker, title, description, align = "left" } = Astro.props;
---

<div
  class:list={[
    "reveal",
    "max-w-2xl",
    align === "center" &&
      "mx-auto flex flex-col items-center text-center",
  ]}
>
  <p class="mb-3 font-mono text-xs tracking-[0.2em] text-glow">{kicker}</p>
  <h2 class="font-display text-2xl font-bold tracking-tight sm:text-4xl">
    {title}
  </h2>
  {description && (
    <p class="mt-4 leading-relaxed text-mute">{description}</p>
  )}
</div>