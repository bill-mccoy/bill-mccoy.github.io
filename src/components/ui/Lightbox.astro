---
const lightboxId = "lightbox";
---

<div
  id={lightboxId}
  class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-ink/95 p-4 backdrop-blur-sm sm:p-8"
  role="dialog"
  aria-modal="true"
  aria-label="Visor de imagen"
>
  <img
    src=""
    alt=""
    data-lb-img
    class="max-h-[78vh] max-w-[92vw] rounded-lg border border-line object-contain"
  />
  <button
    type="button"
    data-lb-close
    class="absolute right-4 top-4 grid size-10 place-items-center rounded-full border border-line bg-surface/70 text-mute transition-colors hover:text-glow"
    aria-label="Cerrar visor"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M18 6 6 18" />
      <path d="m6 6 12 12" />
    </svg>
  </button>
  <button
    type="button"
    data-lb-prev
    class="absolute left-3 top-1/2 grid size-10 -translate-y-1/2 place-items-center rounded-full border border-line bg-surface/70 text-mute transition-colors hover:text-glow sm:left-6"
    aria-label="Imagen anterior"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m15 18-6-6 6-6" />
    </svg>
  </button>
  <button
    type="button"
    data-lb-next
    class="absolute right-3 top-1/2 grid size-10 -translate-y-1/2 place-items-center rounded-full border border-line bg-surface/70 text-mute transition-colors hover:text-glow sm:right-6"
    aria-label="Imagen siguiente"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m9 18 6-6-6-6" />
    </svg>
  </button>
  <p data-lb-caption class="absolute bottom-4 left-1/2 w-max max-w-[90vw] -translate-x-1/2 truncate font-mono text-xs text-faint"></p>
</div>

<script>
  const root = document.getElementById("lightbox");
  if (root) {
    const img = root.querySelector<HTMLImageElement>("[data-lb-img]");
    const caption = root.querySelector<HTMLElement>("[data-lb-caption]");

    let list: HTMLAnchorElement[] = [];
    let index = 0;

    const render = () => {
      const current = list[index];
      if (!current || !img) return;
      img.src = current.href;
      img.alt = current.dataset.caption ?? "";
      if (caption) {
        caption.textContent = current.dataset.caption ?? "";
      }
    };

    const open = () => {
      if (!img) return;
      root.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      render();
    };

    const close = () => {
      root.classList.add("hidden");
      document.body.style.overflow = "";
      if (img) img.src = "";
    };

    const step = (dir: number) => {
      index = (index + dir + list.length) % list.length;
      render();
    };

    document
      .querySelectorAll<HTMLAnchorElement>("a[data-lightbox]")
      .forEach((trigger) => {
        trigger.addEventListener("click", (e) => {
          e.preventDefault();
          const group = trigger.dataset.lightboxGroup ?? "";
          list = Array.from(
            document.querySelectorAll<HTMLAnchorElement>(
              `a[data-lightbox-group="${group}"]`,
            ),
          );
          index = list.indexOf(trigger);
          open();
        });
      });

    root.addEventListener("click", (e) => {
      if (e.target === root) close();
    });
    root
      .querySelector("[data-lb-close]")
      ?.addEventListener("click", close);
    root
      .querySelector("[data-lb-prev]")
      ?.addEventListener("click", () => step(-1));
    root
      .querySelector("[data-lb-next]")
      ?.addEventListener("click", () => step(1));

    document.addEventListener("keydown", (e) => {
      if (root.classList.contains("hidden")) return;
      if (e.key === "Escape") close();
      if (e.key === "ArrowLeft") step(-1);
      if (e.key === "ArrowRight") step(1);
    });
  }
</script>