---
const nav = [
  { label: "Inicio", href: "/#inicio" },
  { label: "Proyectos", href: "/#proyectos" },
  { label: "Open Source", href: "/#open-source" },
  { label: "CV", href: "/cv" },
  { label: "Contacto", href: "/#contacto" },
];
---

<header class="glass sticky top-0 z-50 border-x-0 border-t-0">
  <div
    class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-5 sm:px-8"
  >
    <a href="/#inicio" class="group flex items-center gap-3" aria-label="Inicio">
      <span
        class="grid size-8 place-items-center rounded-lg bg-gradient-to-br from-glow/25 to-cad/15 font-mono text-xs font-bold text-glow ring-1 ring-line transition-transform group-hover:-translate-y-px"
        >JC</span
      >
      <span class="hidden font-display text-sm font-semibold tracking-tight sm:block">
        Juan Cortes
      </span>
      <span class="hidden font-mono text-xs text-faint lg:block"
        >~/bill-mccoy</span
      >
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Navegación">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="rounded-md px-3 py-2 text-sm text-mute transition-colors hover:bg-surface-2 hover:text-soft"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <button
      id="menu-toggle"
      class="grid size-9 place-items-center rounded-md text-mute ring-1 ring-transparent transition-colors hover:bg-surface-2 hover:text-soft md:hidden"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M4 7h16" />
        <path d="M4 12h16" />
        <path d="M4 17h16" />
      </svg>
    </button>

    <div
      id="mobile-menu"
      class="glass absolute inset-x-3 top-[4.25rem] hidden flex-col gap-1 rounded-xl p-3 shadow-lift"
    >
      {
        nav.map((item, i) => (
          <a
            href={item.href}
            class="mobile-link rounded-lg px-3 py-2.5 text-sm text-mute transition-colors hover:bg-surface-2 hover:text-soft"
            data-index={i}
          >
            <span class="mr-2 font-mono text-xs text-faint"
              >0{i + 1}</span
            >
            {item.label}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const open = menu.classList.toggle("hidden");
      toggle.setAttribute("aria-expanded", String(!open));
    });

    menu.querySelectorAll<HTMLAnchorElement>(".mobile-link").forEach((link) => {
      link.addEventListener("click", () => {
        menu.classList.add("hidden");
        toggle.setAttribute("aria-expanded", "false");
      });
    });
  }
</script>