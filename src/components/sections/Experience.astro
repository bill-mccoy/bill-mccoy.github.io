---
import SectionHeading from "../ui/SectionHeading.astro";
import { experiences } from "../../data/experience";
---

<section
  id="experiencia"
  class="mx-auto w-full max-w-6xl scroll-mt-24 px-5 py-16 sm:px-8 sm:py-24"
>
  <div class="grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
    <SectionHeading
      kicker="02 · EXPERIENCIA"
      title="Formación y experiencia técnica"
      description="Trabajo y formación: TerraWorks como diseñador 3D y desarrollador de tours virtuales, la universidad y la docencia técnica como ayudante en la PUCV."
    />

    <div class="space-y-5">
      {
        experiences.map((entry, i) => (
          <article class="reveal group flex gap-5" style={`transition-delay: ${i * 90}ms`}>
            <div class="flex flex-col items-center gap-2">
              <span
                class="grid size-10 shrink-0 place-items-center rounded-lg border border-line bg-surface/60 font-mono text-xs text-steel"
              >
                {String(i + 1).padStart(2, "0")}
              </span>
              <span
                class:list={[
                  "hidden w-px flex-1 rounded bg-line min-h-6 sm:block",
                  i === experiences.length - 1 && "opacity-0",
                ]}
                aria-hidden="true"
              ></span>
            </div>

            <div class="pb-1">
              <p class="font-mono text-xs text-faint">{entry.period}</p>
              <h3 class="mt-1 font-display text-lg font-semibold tracking-tight text-soft">
                {entry.role}
              </h3>
              <p class="mt-0.5 text-sm font-medium text-steel">{entry.org}</p>
              <p class="mt-2 text-sm leading-relaxed text-mute">{entry.desc}</p>
              {entry.tags && entry.tags.length > 0 && (
                <ul class="mt-3 flex flex-wrap gap-1.5">
                  {entry.tags.map((tag) => (
                    <li class="rounded-md border border-line-soft bg-surface/50 px-2 py-0.5 font-mono text-[11px] text-mute">
                      {tag}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>