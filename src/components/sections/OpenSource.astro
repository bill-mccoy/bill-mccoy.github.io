---
import SectionHeading from "../ui/SectionHeading.astro";
import { repos } from "../../data/opensource";
---

<section id="open-source" class="mx-auto w-full max-w-6xl scroll-mt-24 px-5 py-16 sm:px-8 sm:py-24">
  <div class="grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
    <SectionHeading
      kicker="04 · CÓDIGO ABIERTO"
      title="Open Source"
      description="No todo lo que construyo está detrás de una marca. Algunos desarrollos viven abiertos en GitHub."
    />

    <ul class="space-y-4">
      {
        repos.map((repo) => (
          <li class="reveal">
            <a
              href={repo.href}
              target="_blank"
              rel="noreferrer noopener"
              class="group hover-lift flex items-start justify-between gap-6 rounded-xl border border-line bg-surface/60 p-5 hover:border-glow/30"
            >
              <div class="min-w-0">
                <div class="flex items-center gap-2.5">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="text-mute transition-colors group-hover:text-glow"
                    aria-hidden="true"
                  >
                    <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                    <path d="M9 18c-4.51 2-5-2-7-2" />
                  </svg>
                  <h3 class="font-display text-base font-semibold tracking-tight transition-colors group-hover:text-glow">
                    {repo.name}
                  </h3>
                </div>
                <p class="mt-2 text-sm leading-relaxed text-mute">
                  {repo.description}
                </p>
                <span class="mt-3 inline-flex items-center gap-2 font-mono text-xs text-faint">
                  <span class="size-1.5 rounded-full bg-cad" aria-hidden="true"></span>
                  {repo.lang}
                </span>
              </div>
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="mt-1 shrink-0 text-faint transition-all group-hover:translate-x-0.5 group-hover:text-glow"
                aria-hidden="true"
              >
                <path d="M7 17 17 7" />
                <path d="M7 7h10v10" />
              </svg>
            </a>
          </li>
        ))
      }

      <li class="reveal" style="transition-delay: 90ms">
        <div class="flex items-center justify-between rounded-xl border border-dashed border-line bg-surface/30 p-5">
          <div>
            <p class="font-mono text-xs text-faint">PROXIMAMENTE</p>
            <p class="mt-1 text-sm text-faint">
              Próximos repos: pipelines de tours, scripts de automatización y
              utilidades internas.
            </p>
          </div>
        </div>
      </li>
    </ul>
  </div>
</section>